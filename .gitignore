# Generated data & large binaries — never committed.
# (Sweden extract 772 MB, clipped pbf, pmtiles, Planetiler sources ~1.4 GB,
#  tile_weights, logs.)
/data/

# Staged/deployed build artifacts (regenerated by the pipeline).
/build/

# planetiler.jar (89 MB), fetched by build-basemap.sh
/tools/*.jar

# Third-party runtime assets, fetched at pinned versions by
# scripts/fetch-app-assets.mjs. Build output, not source.
/app/vendor/
/app/glyphs/
/app/sprite/

# Home-screen icons, drawn by scripts/build-icons.mjs (icon.svg IS source).
/app/icons/*.png

# Node
node_modules/

# OS
.DS_Store
