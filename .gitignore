# Generated data & large binaries — never committed.
# (Sweden extract 772 MB, clipped pbf, pmtiles, overpass cache, Planetiler
#  sources ~1.4 GB, tile_weights, logs.)
/data/

# Staged/deployed build artifacts (regenerated by the pipeline).
/build/

# planetiler.jar (89 MB), fetched by build-basemap.sh
/tools/*.jar

# Third-party runtime assets, fetched at pinned versions by
# scripts/fetch-app-assets.mjs. Build output, not source.
/app/vendor/
/app/glyphs/
/app/sprite/

# Home-screen icons, drawn by scripts/build-icons.mjs (icon.svg IS source).
/app/icons/*.png

# The machine's proposal for Förr's photographs, superseded by game/photos.json
# as soon as it is ruled on. The evidence behind it IS versioned
# (game/photo-candidates.md), the way learn/core-candidates.md is — this is just
# the same rows in a shape that is quicker to edit than to retype.
/game/photos.draft.json

# Node
node_modules/

# OS
.DS_Store

# Review in progress: written by the /review/ page after every keystroke, and
# consumed by scripts/apply-review.mjs. The durable half of a review session is
# game/rejected.json, which IS versioned — a rejection has to outlive the pool
# it was made against, or the next propose-photos run offers it back.
/game/review.json
